{
  "name": "dsh-chat-answer-anchor",
  "version": "0.2.0",
  "description": "冻结 DSH 聊天区的滚动位置：新回答出现时视口不再自动贴到底部，停在你最后停留的地方。",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "cordis.patch.yml",
    "screenshots.json",
    "docs/screenshots/*.png",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node test/selftest.mjs && node test/behav.mjs",
    "bench": "node test/bench.mjs",
    "check": "node --check lib/index.js && node --check lib/client.js"
  },
  "engines": {
    "node": ">=20"
  },
  "dsh": {
    "bundle": {
      "patch": "cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-locale"
      ],
      "platform": "web"
    },
    "engines": {
      "dsh": ">=0.2.0-rc.1"
    },
    "compatibility": {
      "dshReleases": {
        "0.2.0-rc.2": "compatible",
        "0.2.1-alpha.4": "compatible",
        "0.2.1-rc.2": "compatible"
      }
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    }
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "chat",
    "scroll",
    "ux"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/arcnapan/dsh-chat-answer-anchor.git"
  },
  "homepage": "https://github.com/arcnapan/dsh-chat-answer-anchor",
  "bugs": {
    "url": "https://github.com/arcnapan/dsh-chat-answer-anchor/issues"
  },
  "license": "MIT"
}
